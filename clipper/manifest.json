{
  "manifest_version": 3,
  "name": "Petrarca Clipper",
  "version": "2.2",
  "description": "Save articles and highlights to Petrarca — your Renaissance reading companion",
  "permissions": ["activeTab", "storage", "cookies", "alarms"],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.co.jp/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Petrarca Clipper"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://read.amazon.com/*"],
      "js": ["kindle-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://read.amazon.com/notebook*"],
      "js": ["kindle-notebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.amazon.com/hz/mycd/*",
        "*://*.amazon.com/mn/dcw/*",
        "*://*.amazon.co.uk/hz/mycd/*",
        "*://*.amazon.de/hz/mycd/*"
      ],
      "js": ["kindle-manage.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["youtube-content.js"],
      "run_at": "document_idle"
    }
  ]
}
